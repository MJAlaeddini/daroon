# Copy to deploy/.env on the server and fill in. Never commit the real file.
DOMAIN=daroon.example.com
ACME_EMAIL=you@example.com

# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -base64 48
AUTH_SECRET=

# Mail for login codes, e.g. smtps://USER:PASSWORD@smtp.example.com:465
SMTP_URL=
MAIL_FROM=درون <no-reply@daroon.example.com>

# Optional: Google sign-in (OAuth client id of type "Web application", origin https://DOMAIN)
GOOGLE_CLIENT_ID=
# Optional: weekly stories written by Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
STORIES_PER_DAY=12
