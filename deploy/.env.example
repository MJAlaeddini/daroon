# Copy to deploy/.env on the server and fill in. Never commit the real file.
# Pick ONE of the two modes below.

# --- Mode A: own domain with HTTPS (Caddy takes ports 80 and 443) ---
SITE_ADDRESS=daroon.example.com
APP_ORIGIN=https://daroon.example.com
ACME_EMAIL=you@example.com
COOKIE_SECURE=true
HTTP_BIND=80
HTTPS_BIND=443

# --- Mode B: next to another site, on its own port over plain HTTP (temporary) ---
# SITE_ADDRESS=:80
# APP_ORIGIN=http://SERVER_IP:8080
# COOKIE_SECURE=false
# HTTP_BIND=8080
# HTTPS_BIND=127.0.0.1:8443

# openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
# openssl rand -base64 48
AUTH_SECRET=

# Mail for login codes, e.g. smtps://USER:PASSWORD@smtp.example.com:465
SMTP_URL=
MAIL_FROM=درون <no-reply@daroon.example.com>

# Optional: Google sign-in (OAuth client id of type "Web application"; needs HTTPS, so Mode A)
GOOGLE_CLIENT_ID=
# Optional: weekly stories from any OpenAI-compatible chat API. Examples:
#   STORY_API_URL=https://api.openai.com/v1         STORY_MODEL=gpt-4o-mini
#   STORY_API_URL=https://openrouter.ai/api/v1      STORY_MODEL=<any model OpenRouter lists>
#   STORY_API_URL=http://host.docker.internal:11434/v1  STORY_MODEL=<an Ollama model>  (no key)
# Without it, the week's story is a plain summary written on the device.
STORY_API_URL=
STORY_API_KEY=
STORY_MODEL=
STORIES_PER_DAY=12
