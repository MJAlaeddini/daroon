# Copy to .env for local development (pnpm dev). Production values go in deploy/.env.
DATABASE_URL=postgres://daroon:daroon@localhost:5432/daroon
APP_ORIGIN=http://localhost:5173
# 32+ random characters: openssl rand -base64 48
AUTH_SECRET=change-me-change-me-change-me-change-me
# Optional. Without SMTP_URL, login codes are printed to the console.
SMTP_URL=
MAIL_FROM=درون <no-reply@example.com>
# Optional. Google Identity Services OAuth client id (Web application).
GOOGLE_CLIENT_ID=
# Optional. Claude API key for weekly stories; without it the app writes a plain local summary.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
