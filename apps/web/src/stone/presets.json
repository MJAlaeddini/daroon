{
  "project": "Daroon / درون — emotion stone procedural visual system",
  "version": "0.1 design handoff",
  "units": "normalized 0..1 except uplift -1..+1, frequency Hz, colors hex",
  "renderer": {
    "background": "#100E1B",
    "shellCount": 4,
    "radii": [0.58, 0.78, 0.94, 1.06],
    "shellOpacity": [0.82, 0.43, 0.31, 0.25],
    "roughness": 0.34,
    "metalness": 0.0,
    "ior": 1.23,
    "environmentIntensity": 0.45,
    "bloomStrength": 0.17,
    "highlightStrength": 0.42,
    "particleDensity": 0,
    "motionTransitionSeconds": 1.3,
    "motionTransitionEase": "smoothstep",
    "reducedMotion": "disable oscillation but keep morph and shape"
  },
  "maxSelectedEmotions": 3,
  "defaultBlendWeight": "equal, normalize provided intensities if present",
  "orderIndependent": true,
  "mixingRules": {
    "geometry": "single unified base mesh, shape field uses weighted sum of distinct harmonic features; preserve emotion-specific peaks via nonlinear soft-max instead of averaging full meshes",
    "color": "spatially distribute emotion colors in soft overlapping bands / sectors of the SAME shell; do not flat-average RGB or place separate stones beside each other",
    "animation": "interpolate source weights to target weights for continuous geometry/material morph; compose pulse and tremor without adding all frequencies at full amplitude",
    "determinism": "same unordered emotion IDs plus intensities produce same unique target form and palette. Seed = hash(sorted IDs)"
  },
