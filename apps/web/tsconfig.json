{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "noEmit": true,
    /* The interface layer was ported from the prototype as-is; it is typed loosely for now
       and tightened module by module (see docs/architecture.md). */
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false
  },
  "include": ["src", "test", "vite.config.ts", "vitest.config.ts"]
}
